@page "/rooms"
@rendermode InteractiveServer
@using SmartPanel.Shared
@using System.Globalization
@implements IDisposable
@inject SmartPanel.Web.Services.SmartHomeApiClient ApiClient

<PageTitle>Rooms</PageTitle>

<section class="page-shell rooms-neo">
    <header class="page-header neo-header">
        <div>
            <h1>Rooms Command Grid</h1>
            <p class="page-subtitle">Live grouped devices, type-aware details and direct control from one page.</p>
        </div>
        <div class="control-row">
            <button type="button" class="scene-btn" disabled="@refreshingRooms" @onclick="ReloadRoomsAsync">Scan now</button>
            <span class="sensor-updated">Last scan: @lastRoomsScanAt.ToString("HH:mm:ss")</span>
        </div>
    </header>

    <div class="neo-room-overview">
        @foreach (var item in RoomOverview)
        {
            <div class="card neo-card neo-room-overview-item">
                <span class="stat-label">@item.Name</span>
                <strong class="stat-value">@item.Online/@item.Total</strong>
                <span class="sensor-updated">@FormatNullable(item.Temp, " C")</span>
            </div>
        }
    </div>

    <div class="card filter-panel neo-card">
        <div class="filter-grid">
            <div class="filter-group">
                <label for="search">Search</label>
                <input id="search" class="input-control" placeholder="Room or device name..." @bind="searchText" />
            </div>
            <div class="filter-group">
                <label for="status">Status</label>
                <select id="status" class="input-control" @bind="statusFilter">
                    <option value="all">All</option>
                    <option value="online">Online only</option>
                    <option value="offline">Offline only</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="hours">History Range</label>
                <select id="hours" class="input-control" @bind="historyHours">
                    <option value="6">6h</option>
                    <option value="12">12h</option>
                    <option value="24">24h</option>
                    <option value="48">48h</option>
                </select>
            </div>
            <div class="filter-group summary-block">
                <span>Visible Devices</span>
                <strong>@FilteredRooms.Sum(r => r.Sensors.Count)</strong>
            </div>
        </div>
    </div>

    @if (rooms is null)
    {
        <div class="card">Loading rooms...</div>
    }
    else
    {
        <div class="analytics-grid neo-analytics-grid">
            <article class="card neo-card">
                <div class="section-title-row">
                    <h2>Device Type Distribution</h2>
                </div>
                <div class="bars-list">
                    @foreach (var item in TypeDistribution)
                    {
                        <div class="bar-row">
                            <span class="bar-label">@item.Key</span>
                            <div class="bar-track">
                                <div class="bar-fill warm" style="@GetWidthStyle(item.Value, MaxTypeCount)"></div>
                            </div>
                            <strong class="bar-value">@item.Value</strong>
                        </div>
                    }
                </div>
            </article>

            <article class="card sensor-details-card neo-card">
                <div class="section-title-row">
                    <h2>Device Details</h2>
                </div>
                @if (loadingDetails)
                {
                    <p class="page-subtitle">Loading device details...</p>
                }
                else if (!string.IsNullOrWhiteSpace(detailsError))
                {
                    <p class="page-subtitle">@detailsError</p>
                }
                else if (selectedDetails is null)
                {
                    <p class="page-subtitle">Select a device to inspect details.</p>
                }
                else
                {
                    <div class="detail-tabs">
                        <button type="button" class="scene-btn @(detailsTab == "details" ? "scene-btn-active" : "")" @onclick="SelectDetailsTab">Details</button>
                        <button type="button" class="scene-btn @(detailsTab == "logs" ? "scene-btn-active" : "")" @onclick="SelectLogsTab">Logs</button>
                    </div>

                    @if (detailsTab == "details")
                    {
                        <div class="detail-grid">
                            <div class="metric-row"><span>Name</span><strong>@selectedDetails.DisplayName</strong></div>
                            <div class="metric-row"><span>Original</span><strong>@selectedDetails.OriginalName</strong></div>
                            <div class="metric-row"><span>Type</span><strong>@FormatDeviceType(selectedDetails.Type)</strong></div>
                            <div class="metric-row"><span>Room</span><strong>@selectedDetails.RoomName</strong></div>
                            <div class="metric-row"><span>State</span><strong>@selectedDetails.DisplayState</strong></div>
                            <div class="metric-row"><span>Current</span><strong>@FormatCurrentValue(selectedDetails)</strong></div>
                            @if (selectedDetails.Type == "environment" && selectedDetails.HumidityValue.HasValue)
                            {
                                <div class="metric-row"><span>Humidity</span><strong>@FormatNumber(selectedDetails.HumidityValue) @selectedDetails.HumidityUnit</strong></div>
                            }
                            @if (selectedDetails.BatteryLevel.HasValue)
                            {
                                <div class="metric-row"><span>Battery</span><strong>@FormatBattery(selectedDetails.BatteryLevel)</strong></div>
                            }
                            <div class="metric-row"><span>Requested At</span><strong>@selectedDetails.RequestedAt.ToString("HH:mm:ss")</strong></div>
                        </div>

                        <div class="rename-panel">
                            <label class="rename-label" for="display-name-input">Display name</label>
                            <div class="control-row rename-row">
                                <input id="display-name-input"
                                       class="input-control rename-input"
                                       placeholder="@selectedDetails.OriginalName"
                                       @bind="displayNameInput" />
                                <button type="button" class="scene-btn" disabled="@savingDisplayName" @onclick="SaveDisplayNameAsync">Save</button>
                                <button type="button" class="scene-btn" disabled="@savingDisplayName" @onclick="ResetDisplayNameAsync">Reset</button>
                            </div>
                            <label class="rename-label" for="device-type-input">Device type</label>
                            <div class="control-row rename-row">
                                <select id="device-type-input" class="input-control rename-input" @bind="selectedTypeOverride">
                                    <option value="">Auto (@FormatDeviceType(selectedDetails.OriginalType))</option>
                                    @foreach (var typeOption in DeviceTypeOptions)
                                    {
                                        <option value="@typeOption.Key">@typeOption.Value</option>
                                    }
                                </select>
                                <button type="button" class="scene-btn" disabled="@savingTypeOverride" @onclick="SaveTypeOverrideAsync">Save</button>
                                <button type="button" class="scene-btn" disabled="@savingTypeOverride" @onclick="ResetTypeOverrideAsync">Reset</button>
                            </div>
                            <div class="sensor-updated">Stored only in SmartPanel DB. Manual type changes room classification and labels, while the original Home Assistant entity stays unchanged.</div>
                            @if (!string.IsNullOrWhiteSpace(displayNameMessage))
                            {
                                <div class="status-banner rename-status">@displayNameMessage</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(typeOverrideMessage))
                            {
                                <div class="status-banner rename-status">@typeOverrideMessage</div>
                            }
                        </div>

                        @if (selectedDetails.Domain == "climate")
                        {
                            var roomClimateTarget = climateTargetInput ?? selectedDetails.TargetTemperature ?? 20;
                            <article class="card climate-panel-card @(IsClimateOn ? "climate-card-on" : "")">
                                <div class="climate-card-header">
                                    <div>
                                        <h2>@selectedDetails.DisplayName</h2>
                                        <div class="sensor-updated">@selectedDetails.RoomName</div>
                                    </div>
                                    <span class="sensor-status @(selectedDetails.Online ? (IsClimateOn ? "status-online" : "status-offline") : "status-offline")">
                                        @(selectedDetails.Online ? (IsClimateOn ? FormatClimateModeLabel(selectedDetails.CurrentMode) : "OFF") : "Offline")
                                    </span>
                                </div>

                                <div class="climate-temps">
                                    <div class="climate-temp-block">
                                        <div class="climate-temp-label">Current</div>
                                        <div class="climate-temp-value">
                                            @(selectedDetails.CurrentValue.HasValue ? $"{selectedDetails.CurrentValue.Value:0.#}C" : "--")
                                        </div>
                                    </div>
                                    <div class="climate-temp-divider">-></div>
                                    <div class="climate-temp-block">
                                        <div class="climate-temp-label">Target</div>
                                        <div class="climate-temp-target">
                                            <button class="climate-temp-btn" disabled="@sendingClimate" @onclick="() => ChangeTarget(-0.5)">-</button>
                                            <span class="climate-temp-value">@roomClimateTarget.ToString("0.#")C</span>
                                            <button class="climate-temp-btn" disabled="@sendingClimate" @onclick="() => ChangeTarget(0.5)">+</button>
                                        </div>
                                        <button type="button"
                                                class="scene-btn scene-btn-active"
                                                style="margin-top:0.4rem;width:100%"
                                                disabled="@sendingClimate"
                                                @onclick="() => SendClimateCommand(target: roomClimateTarget)">
                                            Set
                                        </button>
                                    </div>
                                </div>

                                <div class="climate-modes">
                                    @foreach (var mode in ClimateModes)
                                    {
                                        <button type="button"
                                                class="scene-btn @(IsModeActive(mode) ? "scene-btn-active" : "")"
                                                disabled="@sendingClimate"
                                                @onclick="() => SendClimateCommand(mode: mode)">
                                            @FormatClimateModeLabel(mode)
                                        </button>
                                    }
                                </div>

                                <div class="control-row" style="margin-top:0.5rem">
                                    <button type="button" class="@GetClimatePowerButtonClass(true)" disabled="@sendingClimate" @onclick="SendClimatePowerOn">Power On</button>
                                    <button type="button" class="@GetClimatePowerButtonClass(false)" disabled="@sendingClimate" @onclick="() => SendClimateCommand(powerOn: false)">Power Off</button>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(climateMessage))
                                {
                                    <div class="status-banner">@climateMessage</div>
                                }
                            </article>
                        }

                        @if (selectedDetails.Domain == "media_player")
                        {
                            <div class="climate-panel">
                                <div class="metric-row">
                                    <span>HA domain</span>
                                    <strong>@selectedDetails.Domain</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(selectedDetails.Source))
                                {
                                    <div class="metric-row">
                                        <span>Source</span>
                                        <strong>@selectedDetails.Source</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedDetails.App))
                                {
                                    <div class="metric-row">
                                        <span>App</span>
                                        <strong>@selectedDetails.App</strong>
                                    </div>
                                }
                                @if (selectedDetails.VolumePercent.HasValue)
                                {
                                    <div class="metric-row">
                                        <span>Volume</span>
                                        <strong>@selectedDetails.VolumePercent%</strong>
                                    </div>
                                }

                                <div class="control-row">
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(powerOn: true)">Power On</button>
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(powerOn: false)">Power Off</button>
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(togglePlayPause: true)">Play/Pause</button>
                                </div>

                                <div class="control-row">
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(volumeDown: true)">Vol -</button>
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(volumeUp: true)">Vol +</button>
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(mute: true)">Mute</button>
                                    <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(mute: false)">Unmute</button>
                                </div>

                                @if (selectedDetails.AvailableSources.Count > 0)
                                {
                                    <div class="control-row">
                                        <select class="input-control tv-source-select" @bind="selectedTvSource">
                                            @foreach (var source in selectedDetails.AvailableSources)
                                            {
                                                <option value="@source">@source</option>
                                            }
                                        </select>
                                        <button type="button" class="scene-btn" disabled="@sendingTv" @onclick="() => SendTvCommandAsync(source: selectedTvSource)">Set Source</button>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(tvMessage))
                                {
                                    <div class="status-banner">@tvMessage</div>
                                }
                            </div>
                        }

                        @if (selectedDetails.Domain == "camera")
                        {
                            <div class="climate-panel">
                                <div class="metric-row">
                                    <span>HA domain</span>
                                    <strong>@selectedDetails.Domain</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(selectedDetails.DeviceClass))
                                {
                                    <div class="metric-row">
                                        <span>Device class</span>
                                        <strong>@selectedDetails.DeviceClass</strong>
                                    </div>
                                }
                                @if (selectedDetails.Capabilities.Count > 0)
                                {
                                    <div class="metric-row">
                                        <span>Capabilities</span>
                                        <strong>@string.Join(", ", selectedDetails.Capabilities)</strong>
                                    </div>
                                }

                                <div class="control-row">
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("up")'>Up</button>
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("down")'>Down</button>
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("left")'>Left</button>
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("right")'>Right</button>
                                </div>

                                <div class="control-row">
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("zoom_in")'>Zoom +</button>
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("zoom_out")'>Zoom -</button>
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("start_recording")'>Record</button>
                                </div>

                                <div class="control-row">
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("enable_motion_detection")'>Motion On</button>
                                    <button type="button" class="scene-btn" disabled="@sendingCamera" @onclick='() => SendCameraCommandAsync("disable_motion_detection")'>Motion Off</button>
                                    <a href="@GetCameraSnapshotUrl(selectedDetails.EntityId)" target="_blank" class="scene-btn camera-link-btn">Snapshot</a>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(cameraMessage))
                                {
                                    <div class="status-banner">@cameraMessage</div>
                                }
                            </div>
                        }

                        @if (selectedDetails.Type == "environment" && EnvironmentCharts.Count > 0)
                        {
                            <div class="chart-grid">
                                @foreach (var chart in EnvironmentCharts)
                                {
                                    <section class="chart-panel">
                                        <div class="chart-panel-header">
                                            <strong>@chart.Title</strong>
                                            <span>@chart.CurrentLabel</span>
                                        </div>
                                        <svg class="history-chart detailed-chart" viewBox="0 0 320 160" preserveAspectRatio="none" role="img" aria-label="@chart.Title history chart">
                                            @foreach (var gridLine in ChartGridLines)
                                            {
                                                <line x1="40" y1="@FormatSvg(gridLine)" x2="304" y2="@FormatSvg(gridLine)" class="chart-grid-line" />
                                            }
                                            <polyline fill="none" stroke="@chart.Stroke" stroke-width="3" points="@chart.Polyline" />
                                            @foreach (var zone in chart.Zones)
                                            {
                                                <rect x="@FormatSvg(zone.X)" y="12" width="@FormatSvg(zone.Width)" height="112" class="chart-hover-zone">
                                                    <title>@zone.Tooltip</title>
                                                </rect>
                                            }
                                            @foreach (var point in chart.Points)
                                            {
                                                <circle cx="@FormatSvg(point.X)" cy="@FormatSvg(point.Y)" r="3.4" fill="@chart.Stroke" class="chart-point">
                                                    <title>@point.Tooltip</title>
                                                </circle>
                                            }
                                        </svg>
                                        <div class="chart-axis-row">
                                            <span>@chart.StartLabel</span>
                                            <span>@chart.EndLabel</span>
                                        </div>
                                        <div class="metric-row">
                                            <span>Min/Max</span>
                                            <strong>@chart.MinLabel / @chart.MaxLabel</strong>
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                        else if (NumericHistoryPoints.Count >= 2)
                        {
                            <svg class="history-chart" viewBox="0 0 300 120" preserveAspectRatio="none" role="img" aria-label="Device history chart">
                                <polyline fill="none" stroke="var(--primary)" stroke-width="2.5" points="@BuildSparkline(NumericHistoryPoints)" />
                            </svg>
                            <div class="metric-row">
                                <span>Min/Max</span>
                                <strong>@GetMinMaxLabel(NumericHistoryPoints, selectedDetails.Unit)</strong>
                            </div>
                        }
                    }
                    else
                    {
                        @if (selectedDetails.Type != "motion" && selectedDetails.Type != "door")
                        {
                            <p class="page-subtitle">Logs are enabled for motion and door devices.</p>
                        }
                        else if (selectedDetails.Type == "motion" && motionDebug is not null)
                        {
                            <div class="motion-live-banner @(IsMotionActive ? "motion-live-on" : "motion-live-off")">
                                <strong>@(IsMotionActive ? "РУХ ЗАРАЗ" : "Руху немає")</strong>
                                <span class="log-time">Last changed: @(motionDebug.LastChanged?.ToString("dd.MM HH:mm:ss") ?? "n/a")</span>
                            </div>
                            <div class="motion-debug-meta">
                                <span>state: @motionDebug.CurrentState</span>
                                <span>last_updated: @(motionDebug.LastUpdated?.ToString("dd.MM HH:mm:ss") ?? "n/a")</span>
                                <span>last_reported: @(motionDebug.LastReported?.ToString("dd.MM HH:mm:ss") ?? "n/a")</span>
                            </div>
                        }
                        else if (selectedDetails.Type == "motion" && MotionLogs.Count == 0)
                        {
                            <p class="page-subtitle">No motion events for selected period.</p>
                        }
                        else if (selectedDetails.Type == "motion")
                        {
                            <div class="logs-list">
                                @foreach (var item in MotionLogs)
                                {
                                    <div class="log-item">
                                        <strong>Виявлено рух</strong>
                                        <span class="log-time">@item.ToString("dd.MM HH:mm:ss")</span>
                                    </div>
                                }
                            </div>
                        }
                        else if (DoorLogs.Count == 0)
                        {
                            <p class="page-subtitle">No door open/close events for selected period.</p>
                        }
                        else
                        {
                            <div class="logs-list">
                                @foreach (var entry in DoorLogs)
                                {
                                    <div class="log-item door-log-item">
                                        <div class="log-stack">
                                            <strong>Відкрито</strong>
                                            <span class="log-time">@(entry.OpenedAt?.ToString("dd.MM HH:mm:ss") ?? "поза періодом")</span>
                                        </div>
                                        <div class="log-stack">
                                            <strong>@(entry.ClosedAt.HasValue ? "Закрито" : "Ще відкрито")</strong>
                                            <span class="log-time">@(entry.ClosedAt?.ToString("dd.MM HH:mm:ss") ?? "зараз")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                }
            </article>
        </div>

        @if (FilteredRooms.Count == 0)
        {
            <div class="card">No devices match your filters.</div>
        }
        else
        {
            <div class="rooms-grid neo-rooms-grid">
                @foreach (var room in FilteredRooms)
                {
                    <article class="room-card neo-room-card">
                        <div class="room-card-header">
                            <div>
                                <h3>@room.Name</h3>
                                <span class="sensor-count">@room.Sensors.Count devices</span>
                            </div>
                            <div class="neo-room-card-temp">@FormatNullable(GetRoomAverageTemp(room), " C")</div>
                        </div>

                        <div class="sensor-list">
                            @foreach (var sensor in room.Sensors)
                            {
                                <button type="button"
                                        class="sensor-item sensor-button @(selectedDetails?.EntityId == sensor.Id ? "sensor-selected" : "")"
                                        @onclick="() => LoadSensorDetails(sensor.Id)">
                                    <div class="sensor-top">
                                        <span class="sensor-name">@sensor.Name</span>
                                        <span class="sensor-status @(sensor.Online ? "status-online" : "status-offline")">
                                            @(sensor.Online ? "Online" : "Offline")
                                        </span>
                                    </div>

                                    <div class="sensor-meta">
                                        <span class="sensor-type">@FormatDeviceType(sensor.Type)</span>
                                        @if (sensor.Value.HasValue)
                                        {
                                            <span class="sensor-value">@sensor.Value @sensor.Unit</span>
                                        }
                                        else
                                        {
                                            <span class="sensor-value">@sensor.Status</span>
                                        }
                                    </div>

                                    <div class="sensor-updated">Updated @sensor.UpdatedAt.ToString("HH:mm:ss")</div>
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }
</section>

@code {
    private List<RoomDto>? rooms;
    private string searchText = string.Empty;
    private string statusFilter = "all";
    private int historyHours = 24;
    private bool loadingDetails;
    private string? detailsError;
    private SensorDetailsDto? selectedDetails;
    private bool sendingClimate;
    private string? climateMessage;
    private double? climateTargetInput;
    private bool sendingTv;
    private string? tvMessage;
    private string? selectedTvSource;
    private bool sendingCamera;
    private string? cameraMessage;
    private string displayNameInput = string.Empty;
    private bool savingDisplayName;
    private string? displayNameMessage;
    private string selectedTypeOverride = string.Empty;
    private bool savingTypeOverride;
    private string? typeOverrideMessage;
    private bool refreshingRooms;
    private string detailsTab = "details";
    private readonly List<DateTime> motionLiveEvents = [];
    private string? lastMotionState;
    private MotionDebugDto? motionDebug;
    private DateTime lastRoomsScanAt = DateTime.Now;
    private PeriodicTimer? roomsScanTimer;
    private CancellationTokenSource? roomsScanLoopCts;

    private List<SensorHistoryPointDto> NumericHistoryPoints => GetNumericHistoryPoints();
    private List<ChartModel> EnvironmentCharts => GetEnvironmentCharts();
    private static readonly double[] ChartGridLines = [20, 48, 76, 104];
    private static readonly IReadOnlyList<KeyValuePair<string, string>> DeviceTypeOptions =
    [
        new("environment", "Environment"),
        new("climate", "Climate"),
        new("media", "Media"),
        new("camera", "Camera"),
        new("motion", "Motion"),
        new("door", "Door"),
        new("leak", "Leak"),
        new("light", "Light"),
        new("temp", "Temperature"),
        new("humidity", "Humidity"),
        new("switch", "Switch"),
        new("lock", "Lock"),
        new("cover", "Cover"),
        new("sensor", "Sensor"),
        new("other", "Other")
    ];

    private List<(string Name, int Online, int Total, double? Temp)> RoomOverview =>
        FilteredRooms
            .Select(r =>
                (
                    Name: r.Name,
                    Online: r.Sensors.Count(s => s.Online),
                    Total: r.Sensors.Count,
                    Temp: GetRoomAverageTemp(r)
                ))
            .OrderByDescending(x => x.Online)
            .ThenBy(x => x.Name)
            .Take(6)
            .ToList();

    private List<string> ClimateModes =>
        selectedDetails?.AvailableModes.Count > 0
            ? selectedDetails.AvailableModes
            : ["off", "cool", "heat", "fan_only", "dry", "auto"];

    private bool IsClimateOn =>
        selectedDetails is not null &&
        !string.Equals(selectedDetails.CurrentMode, "off", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(selectedDetails.RawState, "off", StringComparison.OrdinalIgnoreCase);

    private List<RoomDto> FilteredRooms
    {
        get
        {
            if (rooms is null)
            {
                return [];
            }

            var result = new List<RoomDto>();
            foreach (var room in rooms)
            {
                var roomMatches = RoomMatchesSearch(room.Name);
                var sensorsByStatus = room.Sensors.Where(MatchesStatus).ToList();
                var sensorsBySearch = sensorsByStatus.Where(MatchesSearchText).ToList();

                if (sensorsBySearch.Count == 0 && !roomMatches)
                {
                    continue;
                }

                result.Add(new RoomDto
                {
                    Id = room.Id,
                    Name = room.Name,
                    Sensors = sensorsBySearch.Count > 0 ? sensorsBySearch : sensorsByStatus
                });
            }

            return result;
        }
    }

    private Dictionary<string, int> TypeDistribution =>
        FilteredRooms
            .SelectMany(r => r.Sensors)
            .GroupBy(s => s.Type)
            .OrderByDescending(g => g.Count())
            .ToDictionary(g => g.Key, g => g.Count());

