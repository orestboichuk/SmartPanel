    private async Task LoadSensorDetails(string sensorId)
    {
        loadingDetails = true;
        detailsError = null;
        climateMessage = null;
        tvMessage = null;
        cameraMessage = null;
        displayNameMessage = null;
        typeOverrideMessage = null;

        try
        {
            selectedDetails = await ApiClient.GetSensorDetailsAsync(sensorId, historyHours);
            if (selectedDetails is null)
            {
                detailsError = "Device not found in API.";
                return;
            }

            detailsTab = "details";
            TrackMotionEvent(selectedDetails, reset: true);
            await LoadMotionDebugAsync(selectedDetails);
            climateTargetInput = selectedDetails.TargetTemperature ?? selectedDetails.CurrentValue;
            SyncDisplayNameInput();
            SyncTypeOverrideInput();
            SyncDeviceControlState();
        }
        catch (Exception ex)
        {
            detailsError = $"Load error: {ex.Message}";
        }
        finally
        {
            loadingDetails = false;
        }
    }

    private async Task SendClimateCommand(bool? powerOn = null, string? mode = null, double? target = null)
    {
        if (selectedDetails is null || !selectedDetails.Domain.Equals("climate", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        sendingClimate = true;
        climateMessage = null;
        detailsError = null;

        try
        {
            await ApiClient.ControlClimateAsync(new ClimateControlRequestDto
            {
                EntityId = selectedDetails.EntityId,
                PowerOn = powerOn,
                HvacMode = mode,
                TargetTemperature = target
            });

            climateMessage = "Command sent.";
            await RefreshSelectedDetails();
            await ReloadRoomsAsync();
        }
        catch (Exception ex)
        {
            detailsError = $"Control error: {ex.Message}";
        }
        finally
        {
            sendingClimate = false;
        }
    }

