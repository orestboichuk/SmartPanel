    private static bool IsMotionDetectedState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state))
        {
            return false;
        }

        return state.Equals("on", StringComparison.OrdinalIgnoreCase) ||
               state.Equals("detected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDoorOpenState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state))
        {
            return false;
        }

        return state.Equals("on", StringComparison.OrdinalIgnoreCase) ||
               state.Equals("open", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDoorClosedState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state))
        {
            return false;
        }

        return state.Equals("off", StringComparison.OrdinalIgnoreCase) ||
               state.Equals("closed", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ReloadRoomsAsync()
    {
        refreshingRooms = true;

        try
        {
            rooms = await ApiClient.GetRoomsAsync();
            lastRoomsScanAt = DateTime.Now;

            if (selectedDetails is not null)
            {
                await RefreshSelectedDetails();
            }
        }
        catch (Exception ex)
        {
            detailsError = $"Scan error: {ex.Message}";
        }
        finally
        {
            refreshingRooms = false;
        }
    }

    private void StartRoomsScanLoop()
    {
        roomsScanLoopCts = new CancellationTokenSource();
        roomsScanTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));

        _ = Task.Run(async () =>
        {
            try
            {
                while (roomsScanTimer is not null &&
                       await roomsScanTimer.WaitForNextTickAsync(roomsScanLoopCts.Token))
                {
                    await InvokeAsync(ReloadRoomsAsync);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // Normal dispose path
            }
        }, roomsScanLoopCts.Token);
    }

