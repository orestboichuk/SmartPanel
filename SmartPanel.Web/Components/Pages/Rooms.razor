    private List<DateTime> GetMotionLogs()
    {
        if (selectedDetails?.Type != "motion")
        {
            return [];
        }

        var historyEvents = selectedDetails.History is null
            ? []
            : selectedDetails.History
                .Where(x => IsMotionDetectedState(x.State))
                .Select(x => x.Timestamp)
                .ToList();

        var debugEvents = motionDebug?.HistoryPoints is null
            ? []
            : motionDebug.HistoryPoints
                .Where(x => IsMotionDetectedState(x.State))
                .Select(x => x.Timestamp)
                .ToList();

        return historyEvents
            .Concat(debugEvents)
            .Concat(motionLiveEvents)
            .Distinct()
            .OrderByDescending(x => x)
            .ToList();
    }

    private List<DoorLogEntry> GetDoorLogs()
    {
        if (selectedDetails?.Type != "door" || selectedDetails.History is null)
        {
            return [];
        }

        var orderedEvents = selectedDetails.History
            .OrderBy(x => x.Timestamp)
            .GroupBy(x => x.Timestamp)
            .Select(g => g.Last())
            .Where(x => IsDoorOpenState(x.State) || IsDoorClosedState(x.State))
            .ToList();

        if (orderedEvents.Count == 0)
        {
            return [];
        }

        var result = new List<DoorLogEntry>();
        DateTime? openedAt = null;

        foreach (var item in orderedEvents)
        {
            if (IsDoorOpenState(item.State))
            {
                openedAt = item.Timestamp;
                continue;
            }

            if (openedAt.HasValue)
            {
                result.Add(new DoorLogEntry(openedAt.Value, item.Timestamp));
                openedAt = null;
            }
            else
            {
                result.Add(new DoorLogEntry(null, item.Timestamp));
            }
        }

        if (openedAt.HasValue)
        {
            result.Add(new DoorLogEntry(openedAt.Value, null));
        }

        return result
            .OrderByDescending(x => x.OpenedAt ?? x.ClosedAt ?? DateTime.MinValue)
            .ToList();
    }

    private void TrackMotionEvent(SensorDetailsDto? details, bool reset = false)
    {
        if (reset)
        {
            motionLiveEvents.Clear();
            lastMotionState = null;
        }

        if (details?.Type != "motion")
        {
            return;
        }

        var currentState = string.IsNullOrWhiteSpace(details.RawState)
            ? details.DisplayState
            : details.RawState;

        var isDetectedNow = IsMotionDetectedState(currentState);
        var wasDetectedBefore = IsMotionDetectedState(lastMotionState);

        if (isDetectedNow && !wasDetectedBefore)
        {
            motionLiveEvents.Add(details.RequestedAt);
        }

        lastMotionState = currentState;
    }

