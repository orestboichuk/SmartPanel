    private static string GetWidthStyle(int value, int maxValue)
    {
        var width = maxValue == 0 ? 0 : (double)value / maxValue * 100;
        var widthText = Math.Clamp(width, 6, 100).ToString("0.###", CultureInfo.InvariantCulture);
        return $"width: {widthText}%";
    }

    private static string BuildSparkline(List<SensorHistoryPointDto> points)
    {
        var orderedPoints = points
            .OrderBy(x => x.Timestamp)
            .GroupBy(x => x.Timestamp)
            .Select(g => g.Last())
            .ToList();

        var values = orderedPoints.Select(x => x.Value!.Value).ToList();
        var min = values.Min();
        var max = values.Max();
        var span = Math.Max(max - min, 0.001);
        var minTime = orderedPoints.Min(x => x.Timestamp);
        var maxTime = orderedPoints.Max(x => x.Timestamp);
        var totalSeconds = Math.Max((maxTime - minTime).TotalSeconds, 1);

        var segments = new List<string>();
        for (var i = 0; i < orderedPoints.Count; i++)
        {
            var timeOffset = (orderedPoints[i].Timestamp - minTime).TotalSeconds;
            var x = timeOffset / totalSeconds * 300.0;
            var normalized = (values[i] - min) / span;
            var y = 110 - normalized * 100;
            var xText = x.ToString("0.###", CultureInfo.InvariantCulture);
            var yText = y.ToString("0.###", CultureInfo.InvariantCulture);
            segments.Add($"{xText},{yText}");
        }

        return string.Join(" ", segments);
    }

    private List<ChartModel> GetEnvironmentCharts()
    {
        if (selectedDetails?.Type != "environment")
        {
            return [];
        }

        var result = new List<ChartModel>();
        var temperatureChart = BuildChartModel(
            selectedDetails.TemperatureHistory,
            "Temperature",
            selectedDetails.Unit,
            "var(--primary)");
        var humidityChart = BuildChartModel(
            selectedDetails.HumidityHistory,
            "Humidity",
            selectedDetails.HumidityUnit ?? "%",
            "#f0b13a");

        if (temperatureChart is not null)
        {
            result.Add(temperatureChart);
        }

        if (humidityChart is not null)
        {
            result.Add(humidityChart);
        }

        return result;
    }

    private static ChartModel? BuildChartModel(
        List<SensorHistoryPointDto>? sourcePoints,
        string title,
        string? unit,
        string stroke)
    {
        if (sourcePoints is null)
        {
            return null;
        }

        var points = sourcePoints
            .Where(x => x.Value.HasValue && !double.IsNaN(x.Value.Value) && !double.IsInfinity(x.Value.Value))
            .OrderBy(x => x.Timestamp)
            .GroupBy(x => x.Timestamp)
            .Select(g => g.Last())
            .ToList();

        if (points.Count < 2)
        {
            return null;
        }

        const double chartLeft = 40;
        const double chartRight = 304;
        const double chartTop = 16;
        const double chartBottom = 116;

        var values = points.Select(x => x.Value!.Value).ToList();
        var min = values.Min();
        var max = values.Max();
        var span = Math.Max(max - min, 0.001);
        var minTime = points.Min(x => x.Timestamp);
        var maxTime = points.Max(x => x.Timestamp);
        var totalSeconds = Math.Max((maxTime - minTime).TotalSeconds, 1);

        var chartPoints = new List<ChartPoint>();
        for (var index = 0; index < points.Count; index++)
        {
            var item = points[index];
            var timeOffset = (item.Timestamp - minTime).TotalSeconds;
            var x = chartLeft + timeOffset / totalSeconds * (chartRight - chartLeft);
            var normalized = (item.Value!.Value - min) / span;
            var y = chartBottom - normalized * (chartBottom - chartTop);
            chartPoints.Add(new ChartPoint(
                x,
                y,
                item.Timestamp,
                item.Value.Value,
                $"{item.Timestamp:dd.MM HH:mm} | {FormatNumber(item.Value)} {unit}".Trim()));
        }

        var polyline = string.Join(" ", chartPoints.Select(x => $"{FormatSvg(x.X)},{FormatSvg(x.Y)}"));
        var zones = new List<ChartHoverZone>();
        for (var index = 0; index < chartPoints.Count; index++)
        {
            var previousX = index == 0 ? chartLeft : (chartPoints[index - 1].X + chartPoints[index].X) / 2.0;
            var nextX = index == chartPoints.Count - 1 ? chartRight : (chartPoints[index].X + chartPoints[index + 1].X) / 2.0;
            zones.Add(new ChartHoverZone(previousX, Math.Max(nextX - previousX, 6), chartPoints[index].Tooltip));
        }

        return new ChartModel(
            title,
            unit ?? string.Empty,
            stroke,
            chartPoints,
            zones,
            polyline,
            $"{FormatNumber(chartPoints.Last().Value)} {unit}".Trim(),
            $"{FormatNumber(min)} {unit}".Trim(),
            $"{FormatNumber(max)} {unit}".Trim(),
            minTime.ToString("HH:mm"),
            maxTime.ToString("HH:mm"));
    }

