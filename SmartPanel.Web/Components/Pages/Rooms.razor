    private string? GetPreferredOnMode()
    {
        if (selectedDetails is null)
        {
            return null;
        }

        var current = selectedDetails.CurrentMode;
        if (!string.IsNullOrWhiteSpace(current) && !current.Equals("off", StringComparison.OrdinalIgnoreCase))
        {
            return current;
        }

        var modes = ClimateModes;
        var preferred = modes.FirstOrDefault(m => m.Equals("cool", StringComparison.OrdinalIgnoreCase))
            ?? modes.FirstOrDefault(m => m.Equals("auto", StringComparison.OrdinalIgnoreCase))
            ?? modes.FirstOrDefault(m => !m.Equals("off", StringComparison.OrdinalIgnoreCase));

        return preferred;
    }

