@page "/lighting"
@rendermode InteractiveServer
@using SmartPanel.Shared
@inject SmartPanel.Web.Services.SmartHomeApiClient ApiClient

<PageTitle>Освітлення</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <h1>Освітлення</h1>
        </div>
        <div class="control-row">
            <button type="button" class="scene-btn" disabled="@loading" @onclick="LoadAsync">Оновити</button>
        </div>
    </header>

    @if (error is not null)
    {
        <div class="card">Помилка: @error</div>
    }
    else if (lights is null)
    {
        <div class="card">Завантаження...</div>
    }
    else if (lights.Count == 0)
    {
        <div class="card">Пристроїв освітлення не знайдено.</div>
    }
    else
    {
        <div class="lights-grid">
            @foreach (var light in lights)
            {
                <article class="card light-card @(light.IsOn ? "light-card-on" : "")">
                    <div class="light-icon">
                        <span class="light-bulb @(light.IsOn ? "light-bulb-on" : "light-bulb-off")">💡</span>
                    </div>
                    <div class="light-info">
                        <strong>@light.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(light.RoomName))
                        {
                            <div class="sensor-updated">@light.RoomName</div>
                        }
                        <div class="sensor-updated">
                            @(light.IsOn ? "Увімкнено" : "Вимкнено")
                            @if (light.Brightness.HasValue && light.IsOn)
                            {
                                <span> · @light.Brightness%</span>
                            }
                        </div>
                    </div>
                    <div class="light-controls">
                        <button type="button"
                                class="scene-btn @(light.IsOn ? "scene-btn-active" : "")"
                                @onclick="@(() => ToggleAsync(light.Id))">
                            @(light.IsOn ? "Вимкнути" : "Увімкнути")
                        </button>
                    </div>
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="card status-banner">@statusMessage</div>
    }
</section>

@code {
    private List<LightDto>? lights;
    private bool loading;
    private string? error;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            lights = await ApiClient.GetLightsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleAsync(string entityId)
    {
        statusMessage = null;
        try
        {
            await ApiClient.ControlLightAsync(new LightControlRequestDto { EntityId = entityId });
            await Task.Delay(600);
            lights = await ApiClient.GetLightsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Помилка: {ex.Message}";
        }
    }
}
